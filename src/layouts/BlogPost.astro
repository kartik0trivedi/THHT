---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import Comments from '../components/Comments.astro';
import Subscribe from '../components/Subscribe.astro';
import type { MarkdownHeading } from 'astro';

type Props = CollectionEntry<'writing'>['data'] & {
  headings?: MarkdownHeading[];
  readingTime?: string;
  id?: string;
  showComments?: boolean;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  toc = false,
  readingTime,
  id,
  headings = [],
  showComments = true,
} = Astro.props;

const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const showToc = toc && tocHeadings.length > 0;
const ogImage = heroImage ?? (id ? `/og/${id}.png` : undefined);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={ogImage} />
    <style>
      main {
        width: min(1380px, calc(100% - 2rem));
        max-width: none;
        padding-inline: 1rem;
      }

      .post-shell {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .post-header {
        padding: 2rem 0 1.5rem;
        border-bottom: 1px solid var(--border);
      }

      .post-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
      }

      .post-date {
        font-family: var(--font-sans);
        font-size: 0.82rem;
        color: var(--ink-muted);
      }

      .post-updated {
        font-family: var(--font-sans);
        font-size: 0.78rem;
        color: var(--ink-muted);
        font-style: italic;
      }

      .meta-sep {
        color: var(--border);
        font-size: 0.9rem;
      }

      .post-title {
        font-size: 2.4rem;
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 0.75rem;
        letter-spacing: -0.02em;
      }

      .post-description {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        color: var(--ink-muted);
        line-height: 1.65;
        margin: 0;
        font-style: italic;
      }

      .hero-image {
        margin-bottom: 1.5rem;
      }

      .hero-image img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        display: block;
        box-shadow: var(--shadow-md);
      }

      .post-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        align-items: start;
      }

      .prose-wrap {
        min-width: 0;
      }

      .prose {
        max-width: min(100%, 720px);
        margin: 0 auto;
        overflow: visible;
      }

      .rail {
        display: none;
        align-self: start;
      }

      .toc-rail {
        position: sticky;
        top: 6.5rem;
      }

      .rail-panel {
        max-height: calc(100vh - 8rem);
        overflow: auto;
        padding: 1rem 1.1rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: color-mix(in srgb, var(--paper) 84%, white 16%);
        box-shadow: var(--shadow-sm);
      }

      .rail-title {
        margin: 0 0 0.9rem;
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-muted);
      }

      .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .toc-list li + li {
        margin-top: 0.55rem;
      }

      .toc-list a {
        display: block;
        position: relative;
        padding: 0.18rem 0.2rem 0.18rem 0.9rem;
        border-radius: 8px;
        font-family: var(--font-sans);
        font-size: 0.92rem;
        line-height: 1.45;
        color: var(--ink-muted);
        text-decoration: none;
        transition: color var(--transition), background-color var(--transition);
      }

      .toc-list a::before {
        content: '';
        position: absolute;
        left: 0.12rem;
        top: 0.45rem;
        bottom: 0.45rem;
        width: 3px;
        border-radius: 999px;
        background: transparent;
        transition: background-color var(--transition);
      }

      .toc-list a:hover {
        color: var(--ink);
        text-decoration: none;
        background: rgba(192, 57, 43, 0.05);
      }

      .toc-list a.active,
      .toc-list a[aria-current='true'] {
        color: var(--ink);
        background: rgba(192, 57, 43, 0.09);
        font-weight: 600;
      }

      .toc-list a.active::before,
      .toc-list a[aria-current='true']::before {
        background: var(--accent);
      }

      .toc-list .depth-3 {
        padding-left: 1.5rem;
        font-size: 0.88rem;
      }

      .toc-list .depth-3::before {
        left: 0.72rem;
      }

      /* Back link */
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        font-family: var(--font-sans);
        font-size: 0.82rem;
        color: var(--ink-muted);
        text-decoration: none;
        margin-bottom: 2.5rem;
        transition: color var(--transition);
      }

      .back-link:hover {
        color: var(--ink);
        text-decoration: none;
      }

      /* Code block copy button */
      .copy-code {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.25rem 0.5rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        background: rgba(255, 255, 255, 0.1);
        color: var(--paper);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 4px;
        cursor: pointer;
        opacity: 0;
        transition: opacity var(--transition), background var(--transition);
      }

      .prose pre {
        position: relative;
      }

      .prose pre:hover .copy-code {
        opacity: 1;
      }

      .copy-code:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      .prose :where(h2, h3, h4, h5, h6) {
        scroll-margin-top: 6.75rem;
      }

      .prose :global(.sidenote-wrapper) {
        display: inline;
      }

      .prose :global(.sidenote-number),
      .prose :global(.sidenote-toggle) {
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--accent);
      }

      .prose :global(.sidenote-number[data-number]),
      .prose :global(.sidenote-toggle[data-number]) {
        font-size: 0;
      }

      .prose :global(.sidenote-number[data-number]::after),
      .prose :global(.sidenote-toggle[data-number]::after) {
        content: attr(data-number);
        font-size: 0.78rem;
      }

      .prose :global(.sidenote-toggle) {
        display: inline;
        margin-left: 0.08rem;
        cursor: pointer;
        vertical-align: super;
        line-height: 0;
        user-select: none;
      }

      .prose :global(.sidenote-toggle-checkbox) {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .prose :global(.sidenote) {
        display: none;
        margin: 0.85rem 0 1rem;
        padding: 0.95rem 1rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--paper-warm);
        box-shadow: var(--shadow-sm);
        font-family: var(--font-serif);
        font-size: 0.96rem;
        line-height: 1.65;
        color: var(--ink-soft);
      }

      .prose :global(.sidenote-number) {
        margin-right: 0.35rem;
      }

      .prose :global(.sidenote-toggle-checkbox:checked + .sidenote) {
        display: block;
      }

      .prose :global(.sidenote :where(a, em, strong, code)) {
        font-size: inherit;
      }

      @media (min-width: 1200px) {
        .post-body.longform {
          grid-template-columns: minmax(190px, 1fr) minmax(0, 720px) minmax(0, 1fr);
          gap: 2rem;
        }

        .post-body.longform .toc-rail {
          display: block;
          grid-column: 1;
          justify-self: end;
          max-width: 240px;
          width: 100%;
        }

        .post-body.longform .prose-wrap {
          grid-column: 2;
        }

        .prose :global(.sidenote) {
          display: block;
          float: right;
          clear: right;
          width: 250px;
          margin-top: 0.15rem;
          margin-right: -290px;
          margin-bottom: 1.25rem;
          padding: 0;
          border: 0;
          border-radius: 0;
          background: transparent;
          box-shadow: none;
          font-size: 0.92rem;
          line-height: 1.55;
        }

        .prose :global(.sidenote-toggle) {
          pointer-events: none;
        }

        .prose :global(.sidenote-toggle-checkbox) {
          display: none;
        }
      }

      @media (max-width: 720px) {
        main {
          width: calc(100% - 1rem);
          padding-inline: 0.5rem;
        }

        .post-title { font-size: 1.9rem; }
        .post-body {
          gap: 1.5rem;
        }

        .toc-rail {
          display: block;
        }

        .toc-rail .rail-panel {
          max-height: none;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <div class="post-shell">
        <a href="/writing" class="back-link">← All writing</a>

        {heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt="" />
          </div>
        )}

        <header class="post-header">
          <div class="post-meta">
            <span class="post-date"><FormattedDate date={pubDate} /></span>
            {readingTime && (
              <>
                <span class="meta-sep">·</span>
                <span class="post-date">{readingTime}</span>
              </>
            )}
            {updatedDate && (
              <>
                <span class="meta-sep">·</span>
                <span class="post-updated">
                  Updated <FormattedDate date={updatedDate} />
                </span>
              </>
            )}
          </div>
          <h1 class="post-title">{title}</h1>
          {description && <p class="post-description">{description}</p>}
          {tags && tags.length > 0 && (
            <div style="margin-top: 1rem;">
              <TagList tags={tags} />
            </div>
          )}
        </header>

        <div class:list={['post-body', { longform: showToc }]}>
          {showToc && (
            <aside class="rail toc-rail" aria-label="Table of contents">
              <div class="rail-panel">
                <h2 class="rail-title">On this page</h2>
                <ol class="toc-list" data-toc-list>
                  {tocHeadings.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={[`depth-${heading.depth}`]}
                        data-toc-link={heading.slug}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </aside>
          )}

          <div class="prose-wrap">
            <article class="prose" data-prose>
              <slot />
            </article>
          </div>
        </div>
      </div>

      <Subscribe />

      {showComments && <Comments />}
    </main>
    <Footer />
    
    <script>
      let copyButtonLabel = "Copy";
      let codeBlocks = Array.from(document.querySelectorAll("pre"));

      for (let codeBlock of codeBlocks) {
        let wrapper = document.createElement("div");
        wrapper.style.position = "relative";

        let copyButton = document.createElement("button");
        copyButton.className = "copy-code";
        copyButton.innerHTML = copyButtonLabel;

        codeBlock.setAttribute("tabindex", "0");
        codeBlock.appendChild(copyButton);

        // Put wrapper around code block
        if (codeBlock.parentNode) {
          codeBlock.parentNode.insertBefore(wrapper, codeBlock);
        }
        wrapper.appendChild(codeBlock);

        copyButton.addEventListener("click", async () => {
          await copyCode(codeBlock, copyButton);
        });
      }

      async function copyCode(block: HTMLElement, button: HTMLElement) {
        let code = block.querySelector("code");
        let text = code ? code.innerText : block.innerText;

        await navigator.clipboard.writeText(text);

        // Visual feedback
        button.innerText = "Copied!";
        button.style.background = "rgba(255, 255, 255, 0.4)";

        setTimeout(() => {
          button.innerText = copyButtonLabel;
          button.style.background = "rgba(255, 255, 255, 0.1)";
        }, 1200);
      }

      let prose = document.querySelector("[data-prose]");
      let tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));

      if (prose && tocLinks.length > 0) {
        let headings = tocLinks
          .map((link) => {
            let slug = link.getAttribute("data-toc-link");
            if (!slug) return null;
            let heading = prose.querySelector(`#${CSS.escape(slug)}`);
            return heading ? { link, heading, slug } : null;
          })
          .filter(Boolean);

        if (headings.length > 0) {
          let setActiveToc = (slug) => {
            for (let entry of headings) {
              let isActive = entry.slug === slug;
              entry.link.classList.toggle("active", isActive);
              if (isActive) {
                entry.link.setAttribute("aria-current", "true");
              } else {
                entry.link.removeAttribute("aria-current");
              }
            }
          };

          let visibleHeadings = new Map();
          let observer = new IntersectionObserver((entries) => {
            for (let entry of entries) {
              let id = entry.target.getAttribute("id");
              if (!id) continue;
              if (entry.isIntersecting) {
                visibleHeadings.set(id, entry.boundingClientRect.top);
              } else {
                visibleHeadings.delete(id);
              }
            }

            if (visibleHeadings.size > 0) {
              let active = Array.from(visibleHeadings.entries())
                .sort((a, b) => Math.abs(a[1]) - Math.abs(b[1]))[0]?.[0];
              if (active) setActiveToc(active);
            } else {
              let current = headings
                .filter((entry) => entry.heading.getBoundingClientRect().top <= 140)
                .at(-1) ?? headings[0];
              if (current) setActiveToc(current.slug);
            }
          }, {
            rootMargin: "-18% 0px -62% 0px",
            threshold: [0, 0.2, 0.6, 1],
          });

          for (let entry of headings) {
            observer.observe(entry.heading);
          }

          setActiveToc(headings[0].slug);
        }
      }
    </script>
  </body>
</html>
